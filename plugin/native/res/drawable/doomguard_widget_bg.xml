<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded dark card matching the floating pill (#1B1B1F -> #0E0E12, hairline stroke). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:startColor="#1B1B1F"
        android:endColor="#0E0E12" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
