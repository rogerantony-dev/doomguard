<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen widget face. RemoteViews only supports the basic layout/widget
  classes, so this stays to nested LinearLayouts + TextViews. The dark gradient
  card and bloodshot-red brand mark echo the floating pill and stopwatch.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/doomguard_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/doomguard_widget_bg"
    android:padding="18dp">

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DOOMGUARD"
        android:textColor="#D6443C"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.18"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0m"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="wasted today"
            android:textColor="#8A8A93"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_reels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬 0 reels"
            android:textColor="#E8E8EE"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_shorts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="▶ 0 shorts"
            android:textColor="#E8E8EE"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
