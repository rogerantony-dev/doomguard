<?xml version="1.0" encoding="utf-8"?>
<!--
  ~4x2 cell widget. updatePeriodMillis=0 because the system minimum (30 min) is
  useless for a live counter; the accessibility service pushes refreshes instead.
  targetCellWidth/Height and previewLayout are API 31+ and ignored on older OSes.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/wilt_widget"
    android:previewLayout="@layout/wilt_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
